#!/usr/bin/perl
# Usage: append-haiku <review URL>
# Appends a haiku about the pull request, as a footer, to a review the user has just submitted.
use strict;
use warnings;
use utf8;
use open qw(:std :encoding(UTF-8));
use Encode qw(decode_utf8 encode_utf8);
use JSON::PP;
use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Spec;
use File::Temp qw(tempfile);
use POSIX qw(setsid _exit);
use Time::Local qw(timegm);

# A wrong URL must not edit an older review, so only a review submitted this recently gets a haiku.
my $max_age = 10 * 60;

my $json = JSON::PP->new->canonical;
my $haiku_sh = abs_path(dirname(__FILE__)) . '/haiku.sh';
my $url = decode_utf8($ARGV[0] // '');
my ($host, $repo, $number, $id) = $url =~ m{^https://([^/]+)/([^/]+/[^/]+)/pull/(\d+)#pullrequestreview-(\d+)\z}
    or fail('Usage: append-haiku <review URL>, such as https://github.com/OWNER/REPO/pull/1#pullrequestreview-2');
my $endpoint = "repos/$repo/pulls/$number/reviews/$id";

my $review = review() or fail("Could not read the review at $url.");
my $login = run('gh', 'api', '--hostname', $host, 'user', '--jq', '.login');
fail('The review was written by someone else.') if ($review->{user}{login} // '') ne $login;
fail('The review is still pending. Submit it first.') if ($review->{state} // '') eq 'PENDING';
fail('The review already has a haiku.') if has_haiku($review);
my $age = time - submitted_at($review);
fail("The review was submitted ${age}s ago, more than ${max_age}s.") if $age > $max_age;

# The agent may run this twice for the same review before the first haiku lands.
my $lock = File::Spec->catdir(File::Spec->tmpdir, "haiku-$host-$id");
mkdir $lock or fail('A haiku for this review is already being written.');

print "Writing a haiku for $url. It is added to the review in the background.\n";
detach();
my $poem = haiku() or do { rmdir $lock; exit 1 };
# The review may have been edited while the haiku was being written.
$review = review() or do { rmdir $lock; exit 1 };
exit 0 if has_haiku($review);
my $body = ($review->{body} // '') =~ s/\s+\z//r;
$body = (length $body ? "$body\n\n" : '')
    . "<!-- haiku_footer_start -->\n**Haiku**\n<sub>$poem</sub>\n<!-- haiku_footer_end -->\n";
run('gh', 'api', '--hostname', $host, '-X', 'PUT', $endpoint, '-f', "body=$body");
exit 0;

sub fail {
    print STDERR "append-haiku: $_[0]\n";
    exit 1;
}

sub review {
    my $text = run('gh', 'api', '--hostname', $host, $endpoint) or return;
    return $json->decode($text);
}

sub has_haiku { ($_[0]{body} // '') =~ /<!-- haiku_footer_start -->/ }

sub submitted_at {
    my ($y, $m, $d, $H, $M, $S) = ($_[0]{submitted_at} // '') =~ /^(\d+)-(\d+)-(\d+)T(\d+):(\d+):(\d+)/ or return 0;
    return timegm($S, $M, $H, $d, $m - 1, $y);
}

# Composing takes a while; detach so the agent's command returns, and the haiku still lands when the session ends first.
sub detach {
    defined(my $pid = fork) or exit 1;
    exit 0 if $pid;
    setsid();
    open STDIN, '<', File::Spec->devnull;
    open STDOUT, '>', File::Spec->devnull;
    open STDERR, '>', File::Spec->devnull;
}

# A haiku about the pull request on one line, or '' if none was written.
sub haiku {
    my $pr_url = "https://$host/$repo/pull/$number";
    my $pr = $json->decode(run('gh', 'pr', 'view', $pr_url, '--json', 'title,body') || '{}');
    my $diff = run('gh', 'pr', 'diff', $pr_url);
    my $files = join "\n", $diff =~ m{^diff --git a/.+? b/(.+)$}mg;
    my ($fh, $material) = tempfile(UNLINK => 1);
    binmode $fh, ':encoding(UTF-8)';
    print $fh "タイトル: ", $pr->{title} // '', "\n\n", $pr->{body} // '', "\n\n変更ファイル:\n$files\n\n差分（先頭）:\n",
        substr($diff, 0, 8000), "\n";
    close $fh;
    return join '', map { s/^\s+|\s+\z//gr } split /\n/, run_with_stdin($material, $haiku_sh);
}

sub run { run_with_stdin(undef, @_) }

# Runs a command and returns its stdout, or '' if it fails.
sub run_with_stdin {
    my ($stdin, @command) = @_;
    my $pid = open(my $out, '-|') // return '';
    if (!$pid) {
        open STDIN, '<', $stdin or _exit(127) if defined $stdin;
        open STDERR, '>', File::Spec->devnull;
        my @argv = map { encode_utf8($_) } @command;
        exec { $argv[0] } @argv or _exit(127);
    }
    my $text = do { local $/; <$out> } // '';
    close $out;
    return $? == 0 ? $text =~ s/\s+\z//r : '';
}
