#!/usr/bin/perl
# PreToolUse hook: denies Bash commands that would skip or loosen the branch name check.
use strict;
use warnings;
use utf8;
binmode STDOUT, ":encoding(UTF-8)";
use JSON::PP;

my $input = decode_json(do { local $/; <STDIN> });
my $command = $input->{tool_input}{command} // '';

my @rules = (
    [qr/\bgit\b[^;&|]*\bpush\b[^;&|]*--no-verify\b/, 'git push --no-verify (skips the pre-push check)'],
    [qr/hook\.never-meaningless-branch-name\./, 'touching hook.never-meaningless-branch-name.*'],
    [qr/\bhook\.pre-push\.enabled\b/, 'hook.pre-push.enabled (turns off every pre-push hook)'],
    [qr/(?:^|[;&|])(?![^;&|]*--get)[^;&|]*(?<![\w.])never-meaningless-branch-name\.[\w.-]+\.(?:pattern|reason)\b/, 'changing never-meaningless-branch-name.<name>.pattern or .reason'],
    # Replacing the global config file also drops hook.never-meaningless-branch-name.
    [qr/\bGIT_CONFIG_(?:GLOBAL|NOSYSTEM)=/, 'replacing the git config files'],
);

for my $rule (@rules) {
    my ($pattern, $what) = @$rule;
    next unless $command =~ $pattern;
    print JSON::PP->new->encode({
        hookSpecificOutput => {
            hookEventName => 'PreToolUse',
            permissionDecision => 'deny',
            permissionDecisionReason => "never-meaningless-branch-name: denied $what. Branches matching the forbidden patterns must not be pushed; rename the branch instead.",
        },
    });
    exit 0;
}
exit 0;
